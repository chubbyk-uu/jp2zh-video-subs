# Large data / model directories — keep dir, ignore contents
models/*
!models/.gitkeep
work/*
!work/.gitkeep
outputs/*
!outputs/.gitkeep

# Input videos can live anywhere; never commit them
*.mp4
*.mkv
*.mov
*.avi
*.wmv
*.flv
*.webm
*.m4v
*.ts
!scripts/jp2zh_gui/translations/*.ts

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Editor / OS
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db
CLAUDE.md

# Logs / temp
*.log
*.tmp
docs/current-experiments.md

# Local project planning notes
docs/PLAN.md
docs/PROJECT_REVIEW_*.md
