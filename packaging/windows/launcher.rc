IDI_APP_ICON ICON "../../scripts/jp2zh_gui/assets/app-icon.ico"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
    IDS_APP_TITLE "jp2zh Subtitle Tool"
    IDS_ERROR_EXE_DIR "Could not determine the application folder."
    IDS_ERROR_INVALID_PATH "The launcher path is invalid."
    IDS_ERROR_PATH_TOO_LONG "The portable folder path is too long."
    IDS_ERROR_INCOMPLETE "The portable folder is incomplete: embedded Python or the GUI script is missing."
    IDS_ERROR_ENVIRONMENT "Could not initialise the portable runtime environment."
    IDS_ERROR_START_FORMAT "Could not start the GUI (Windows error %lu)."
    IDS_ERROR_START_GENERIC "Could not start the GUI."
END

